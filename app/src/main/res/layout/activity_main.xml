<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sr_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/sr_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="@string/phone_subtitle"
            android:textColor="@color/sr_text_muted"
            android:textSize="13sp" />

        <!-- Status & Permissions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_status_permissions"
                android:textColor="@color/sr_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/label_sleep_app"
                android:textColor="@color/sr_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_sleep_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_checking"
                android:textColor="@color/sr_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/label_read_permission"
                android:textColor="@color/sr_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_read_perm_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_checking"
                android:textColor="@color/sr_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_grant_read"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/sr_primary"
                android:text="@string/btn_grant_read"
                android:textColor="@color/sr_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/label_overlay_permission"
                android:textColor="@color/sr_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_overlay_perm_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_checking"
                android:textColor="@color/sr_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_grant_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/sr_primary_dark"
                android:text="@string/btn_grant_overlay"
                android:textColor="@color/sr_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/label_watch_connection"
                android:textColor="@color/sr_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_watch_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_checking"
                android:textColor="@color/sr_teal"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_sync_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/sr_teal"
                android:text="@string/btn_sync_now"
                android:textColor="@color/sr_bg"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Intent API Guide Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_intent_api_guide"
                android:textColor="@color/sr_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/intent_api_guide_body"
                android:textColor="@color/sr_text_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_open_sleep_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/sr_surface_alt"
                android:text="@string/btn_open_sleep_app"
                android:textColor="@color/sr_text" />
        </LinearLayout>

        <!-- Nap Presets & Snooze Config Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_nap_presets"
                android:textColor="@color/sr_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nap_presets_hint"
                android:textColor="@color/sr_text_muted"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_nap_presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_new_nap_preset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hint_new_nap_minutes"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/sr_text"
                    android:textColorHint="@color/sr_text_muted" />

                <Button
                    android:id="@+id/btn_add_nap_preset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/sr_primary"
                    android:text="@string/btn_add"
                    android:textColor="@color/sr_text" />

                <Button
                    android:id="@+id/btn_reset_nap_presets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/sr_surface_alt"
                    android:text="@string/btn_reset"
                    android:textColor="@color/sr_text_muted" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/label_default_snooze"
                android:textColor="@color/sr_text_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_snooze_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/snooze_5m"
                    android:textColor="@color/sr_text" />

                <Button
                    android:id="@+id/btn_snooze_10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/snooze_10m"
                    android:textColor="@color/sr_text" />

                <Button
                    android:id="@+id/btn_snooze_15"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/snooze_15m"
                    android:textColor="@color/sr_text" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Sleep Actions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_quick_actions"
                android:textColor="@color/sr_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_phone_start_track"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sr_primary"
                    android:text="@string/btn_start_tracking"
                    android:textColor="@color/sr_text"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_phone_start_ideal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sr_primary_dark"
                    android:text="@string/btn_start_ideal"
                    android:textColor="@color/sr_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_phone_stop_track"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sr_danger"
                    android:text="@string/btn_stop_tracking"
                    android:textColor="@color/sr_text"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_phone_skip_next"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sr_surface_alt"
                    android:text="@string/btn_skip_next"
                    android:textColor="@color/sr_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sleep Alarms Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_sleep_alarms"
                android:textColor="@color/sr_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_alarms_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/alarms_empty"
                android:textColor="@color/sr_text_muted"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_alarms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
