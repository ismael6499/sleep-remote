<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@color/sr_surface_alt"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_item_alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_time"
            android:textColor="@color/sr_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_alarm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/default_alarm_label"
            android:textColor="@color/sr_teal"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_item_alarm_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/days_one_time"
            android:textColor="@color/sr_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_item_alarm_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
