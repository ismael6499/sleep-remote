<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.SwipeDismissFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wear_swipe_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wear_bg">

    <ScrollView
        android:id="@+id/wear_main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="44dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SCREEN 0: HOME -->
            <LinearLayout
                android:id="@+id/screen_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/wear_teal"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_wear_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_wear_next_alarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/wear_no_active_alarms"
                        android:textColor="@color/wear_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_wear_phone_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:text="@string/wear_status_waiting_sync"
                        android:textColor="@color/wear_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_wear_open_alarms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/wear_primary"
                    android:text="@string/wear_btn_alarms"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text" />

                <Button
                    android:id="@+id/btn_wear_open_naps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/wear_teal"
                    android:text="@string/wear_btn_naps"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_bg"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_wear_open_create"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/wear_card_active"
                    android:text="@string/wear_btn_create_alarm"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text" />

                <Button
                    android:id="@+id/btn_wear_open_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/wear_card_active"
                    android:text="@string/wear_btn_sleep_controls"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text" />

                <Button
                    android:id="@+id/btn_wear_sync_now"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/wear_chip_off"
                    android:text="@string/wear_btn_sync_now"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- SCREEN 1: ALARMS LIST -->
            <LinearLayout
                android:id="@+id/screen_alarms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wear_title_alarms"
                    android:textColor="@color/wear_teal"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_back_alarms"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/wear_chip_off"
                        android:text="@string/wear_btn_back"
                        android:textAllCaps="false"
                        android:textColor="@color/wear_text"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_wear_refresh_alarms"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/wear_card_active"
                        android:text="@string/wear_btn_refresh"
                        android:textAllCaps="false"
                        android:textColor="@color/wear_teal"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_wear_alarms_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- SCREEN 2: QUICK NAPS -->
            <LinearLayout
                android:id="@+id/screen_naps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wear_title_naps"
                    android:textColor="@color/wear_teal"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_back_naps"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="@color/wear_chip_off"
                    android:text="@string/wear_btn_back"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/ll_wear_naps_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- SCREEN 3: CREATE ALARM -->
            <LinearLayout
                android:id="@+id/screen_create"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wear_title_create"
                    android:textColor="@color/wear_teal"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_back_create"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/wear_chip_off"
                    android:text="@string/wear_btn_back"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text"
                    android:textSize="12sp" />

                <!-- Hour & Minute Selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_wear_card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <Button
                        android:id="@+id/btn_hour_minus"
                        android:layout_width="44dp"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/wear_chip_off"
                        android:text="@string/symbol_minus"
                        android:textColor="@color/wear_text" />

                    <TextView
                        android:id="@+id/tv_create_hour"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/placeholder_two_zeros"
                        android:textColor="@color/wear_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_hour_plus"
                        android:layout_width="44dp"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/wear_chip_off"
                        android:text="@string/symbol_plus"
                        android:textColor="@color/wear_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/symbol_colon"
                        android:textColor="@color/wear_teal"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_create_min"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/placeholder_two_zeros"
                        android:textColor="@color/wear_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_min_minus5"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/wear_chip_off"
                        android:text="@string/step_m5"
                        android:textColor="@color/wear_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_min_minus1"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/wear_chip_off"
                        android:text="@string/step_m1"
                        android:textColor="@color/wear_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_min_plus1"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/wear_chip_off"
                        android:text="@string/step_p1"
                        android:textColor="@color/wear_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_min_plus5"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/wear_chip_off"
                        android:text="@string/step_p5"
                        android:textColor="@color/wear_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Optional Repeat Days -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/wear_repeat_days_optional"
                    android:textColor="@color/wear_text_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_day_mon"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:text="@string/day_letter_mon"
                        android:textColor="@color/wear_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_day_tue"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:text="@string/day_letter_tue"
                        android:textColor="@color/wear_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_day_wed"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:text="@string/day_letter_wed"
                        android:textColor="@color/wear_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_day_thu"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:text="@string/day_letter_thu"
                        android:textColor="@color/wear_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_day_fri"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:text="@string/day_letter_fri"
                        android:textColor="@color/wear_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_day_sat"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:text="@string/day_letter_sat"
                        android:textColor="@color/wear_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_day_sun"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:text="@string/day_letter_sun"
                        android:textColor="@color/wear_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_create_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/preset_label_alarm"
                    android:textColor="@color/wear_teal"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_lbl_alarm"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/wear_chip_off"
                        android:text="@string/preset_label_alarm"
                        android:textAllCaps="false"
                        android:textColor="@color/wear_text"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_lbl_work"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/wear_chip_off"
                        android:text="@string/preset_label_work"
                        android:textAllCaps="false"
                        android:textColor="@color/wear_text"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_lbl_wake"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/wear_chip_off"
                        android:text="@string/preset_label_wake"
                        android:textAllCaps="false"
                        android:textColor="@color/wear_text"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_lbl_custom"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/wear_card_active"
                        android:text="@string/wear_btn_custom_label"
                        android:textAllCaps="false"
                        android:textColor="@color/wear_teal"
                        android:textSize="10sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_create_vibrate"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/wear_card_active"
                    android:text="@string/wear_vibrate_on"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_create_save"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/wear_green"
                    android:text="@string/wear_btn_save_alarm"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SCREEN 4: SLEEP CONTROLS -->
            <LinearLayout
                android:id="@+id/screen_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wear_title_controls"
                    android:textColor="@color/wear_teal"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_back_controls"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="@color/wear_chip_off"
                    android:text="@string/wear_btn_back"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_ctrl_start_track"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/wear_green"
                    android:text="@string/wear_ctrl_start_track"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text" />

                <Button
                    android:id="@+id/btn_ctrl_start_ideal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/wear_primary"
                    android:text="@string/wear_ctrl_start_ideal"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text" />

                <Button
                    android:id="@+id/btn_ctrl_stop_track"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/wear_red"
                    android:text="@string/wear_ctrl_stop_track"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text" />

                <Button
                    android:id="@+id/btn_ctrl_snooze"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/wear_amber"
                    android:text="@string/wear_ctrl_snooze"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_bg"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_ctrl_skip_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/wear_card_active"
                    android:text="@string/wear_ctrl_skip_next"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text" />

                <Button
                    android:id="@+id/btn_ctrl_dismiss"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/wear_chip_off"
                    android:text="@string/wear_ctrl_dismiss"
                    android:textAllCaps="false"
                    android:textColor="@color/wear_text" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.SwipeDismissFrameLayout>
